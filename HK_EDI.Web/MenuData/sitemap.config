<?xml version="1.0" encoding="utf-8" ?>
<siteMap>
  <siteMapNode title="Home" controller="Home" action="Overview">

    <siteMapNode title="管理首页" nopResource="管理首页" controller="Home" action="Index" ImageUrl="~/Content/images/ico-dashboard.png" />
    <siteMapNode title="账号管理" nopResource="账号管理" PermissionNames="ManageCustomers, ManageAcl" ImageUrl="~/Content/images/ico-customers.png" >
      <siteMapNode title="账号列表" nopResource="Admin.Customers.Customers" PermissionNames="ManageCustomers" controller="Customer" action="List" />
      <siteMapNode title="角色" nopResource="Admin.Customers.CustomerRoles" PermissionNames="ManageCustomers" controller="CustomerRole" action="List" />
      <siteMapNode title="访问权限" nopResource="Admin.Configuration.ACL" PermissionNames="ManageAcl" controller="Security" action="Permissions" />
    </siteMapNode>
    <siteMapNode title="功能" nopResource="功能" PermissionNames="" ImageUrl="~/Content/images/ico-catalog.png" >
      <siteMapNode title="订单状态查询" nopResource="订单状态查询" PermissionNames="ManageOrders" controller="OrderTrace" action="List" />
      <siteMapNode title="计划任务" nopResource="计划任务" PermissionNames="ManageScheduleTasks" controller="ScheduleTask" action="List" />
      <siteMapNode title="日志" nopResource="日志" PermissionNames="ManageSystemLog" controller="Log" action="List" />
      <siteMapNode title="订单异常明细汇总" nopResource="订单异常明细汇总" PermissionNames="ManageOrders" controller="ManageOrdersErrDetail" action="List" />
    </siteMapNode>
    <siteMapNode title="配置" nopResource="配置" PermissionNames="" ImageUrl="~/Content/images/ico-configuration.png" >
      <siteMapNode title="FayaAdibus获取预计发货单配置" nopResource="FayaAdibus获取预计发货单配置" PermissionNames="ManageSettings" controller="Setting" action="FayaAdibusGetEstimatedShipmentSet" />
      <siteMapNode title="FayaAdibus获取装箱单配置" nopResource="FayaAdibus获取装箱单配置" PermissionNames="ManageSettings" controller="Setting" action="FayaAdibusGetPackingListSet" />
		<siteMapNode title="FayaAdibus获取补货单配置" nopResource="FayaAdibus获取补货单配置" PermissionNames="ManageSettings" controller="Setting" action="fayaadibusReplenishmentOrderSet" />
      <siteMapNode title="仓库配置" nopResource="仓库配置" PermissionNames="ManageOrders" controller="StockSettings" action="List" />
      <siteMapNode title="供应商配置" nopResource="供应商配置" PermissionNames="ManageOrders" controller="VendCustSettings" action="List" />
    </siteMapNode>
  </siteMapNode>
</siteMap>

