@{
    ViewBag.Title = "任务列表";

}

<div class="section-header">
    <div class="title">
        <img src="@Url.Content("~/Content/images/ico-content.png")" alt="" />
        计划任务
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#schedule-tasks-grid").on("click", ".run-now", function (e) {
            showThrobber('@Html.Raw(HttpUtility.JavaScriptStringEncode("运行计划任务"))');
            });
        });
</script>
<table class="adminContent">
    <tr>
        <td>
            <strong>修改后需要重启</strong>
        </td>
    </tr>
    <tr>
        <td>
            <div id="schedule-tasks-grid"></div>
            <script>
                $(document).ready(function () {
                    
                    if(@(ViewData["Isadmin"])=="1")
                    {
                        
                        $("#schedule-tasks-grid").kendoGrid({
                            dataSource: {
                                type: "json",
                                transport: {
                                    read: {
                                        url: '@Html.Raw(Url.Action("List", "ScheduleTask")+"?OSInterfaceID="+ViewData["OSInterfaceID"]+"&CompanyID="+ViewData["CompanyID"])',
                                        type: "POST",
                                        dataType: "json"
                                    },
                                    create: {
                                        url: '/Admin/ScheduleTask/Insert?OSInterfaceID=@(ViewData["OSInterfaceID"])&CompanyID=@(ViewData["CompanyID"])',
                                        type: "POST",
                                        dataType: "json"
                                    },
                                    update: {
                                        url: '@Html.Raw(Url.Action("TaskUpdate", "ScheduleTask")+"?OSInterfaceID="+ViewData["OSInterfaceID"]+"&CompanyID="+ViewData["CompanyID"])',
                                        type: "POST",
                                        dataType: "json"
                                    },
                                    destroy: {
                                        url: "/Admin/ScheduleTask/Delete",
                                        type: "POST",
                                        dataType: "json"
                                    }
                               
                                },
                                schema: {
                                    data: "Data",
                                    total: "Total",
                                    errors: "Errors",
                                    model: {
                                        id: "Id",
                                        fields: {
                                            Name: { editable: true, type: "string" },
                                            Seconds: { editable: true, type: "number" },
                                            Type:{ editable: true, type: "string" },
                                            Enabled: { editable: true, type: "boolean" },
                                            StopOnError: { editable: true, type: "boolean" },
                                            LastStartUtc: { editable: false, type: "date" },
                                            LastEndUtc: { editable: false, type: "date" },
                                            LastSuccessUtc: { editable: false, type: "date" },
                                            Id: { editable: false, type: "number" }
                                        }
                                    }
                                },
                                requestEnd: function(e) {
                                    if (e.type == "create" || e.type == "update") {
                                        this.read();
                                    }
                                },
                                error: function (e) {
                                    display_kendoui_grid_error(e);
                                    this.cancelChanges();
                                },
                                serverPaging: true,
                                serverFiltering: true,
                                serverSorting: true
                            },
                            pageable: {
                                refresh: true,
                                numeric: false,
                                previousNext: false,
                                info: false
                            },
                            toolbar: ["create"],
                            editable: {
                                confirmation: false,
                                mode: "inline"
                            },
                            scrollable: false,
                            columns: [{
                                field: "Name",
                                title: "名称",
                                width: 300
                            }, {
                                field: "Seconds",
                                title: "间隔时间(秒)",
                                width: 50
                            },{
                                field: "Type",
                                title: "类型",
                                width: 400
                            },{
                                field: "Enabled",
                                title: "已启用",
                                width: 100,
                                headerAttributes: { style: "text-align:center" },
                                attributes: { style: "text-align:center" },
                                template: '<img src="@Url.Content("~/Content/images/")active-#=Enabled#.gif" />'
                            }, {
                                field: "StopOnError",
                                title: "发生错误时停止",
                                width: 100,
                                headerAttributes: { style: "text-align:center" },
                                attributes: { style: "text-align:center" },
                                template: '<img src="@Url.Content("~/Content/images/")active-#=StopOnError#.gif" />'
                            }, {
                                field: "LastStartUtc",
                                title: "最后开始日期",
                                width: 200,
                                type: "date",
                                format: "{0:G}"
                            }, {
                                field: "LastEndUtc",
                                title: "最后结束日期",
                                width: 200,
                                type: "date",
                                format: "{0:G}"
                            }, {
                                field: "LastSuccessUtc",
                                title: "最后成功日志",
                                width: 200,
                                type: "date",
                                format: "{0:G}"
                            }, {
                                field: "Id",
                                title: "立即运行",
                                width: 100,
                                // template: '<a href="@Url.Content("~/Admin/ScheduleTask/RunNow/")#=Id#" class="k-button run-now">立即运行</a>'
                                template: function (dataItem) {
                            
                                    // return dataItem.Quantity;
                                    return  '<a href="@Url.Content("~/Admin/ScheduleTask/RunNow/")?Id='+dataItem.Id+'&OSInterfaceID=@ViewData["OSInterfaceID"]&CompanyID=@ViewData["CompanyID"]" class="k-button run-now">立即运行</a>'
                                }
                            }, {
                                command:[ { name: "edit", text: "编辑" },{
                                    name: "destroy",
                                    text: "删除", width:100
                                }]}
                            ]
                        });
                        

                    }else {

                        $("#schedule-tasks-grid").kendoGrid({
                            dataSource: {
                                type: "json",
                                transport: {
                                    read: {
                                        url: '@Html.Raw(Url.Action("List", "ScheduleTask")+"?OSInterfaceID="+ViewData["OSInterfaceID"]+"&CompanyID="+ViewData["CompanyID"])',
                                        type: "POST",
                                        dataType: "json"
                                    },
                                    update: {
                                        url: '@Html.Raw(Url.Action("TaskUpdate", "ScheduleTask")+"?OSInterfaceID="+ViewData["OSInterfaceID"]+"&CompanyID="+ViewData["CompanyID"])',
                                        type: "POST",
                                        dataType: "json"
                                    }
                               
                                },
                                schema: {
                                    data: "Data",
                                    total: "Total",
                                    errors: "Errors",
                                    model: {
                                        id: "Id",
                                        fields: {
                                            Name: { editable: true, type: "string" },
                                            Seconds: { editable: true, type: "number" },
            
                                            Enabled: { editable: true, type: "boolean" },
                                            StopOnError: { editable: true, type: "boolean" },
                                            LastStartUtc: { editable: false, type: "date" },
                                            LastEndUtc: { editable: false, type: "date" },
                                            LastSuccessUtc: { editable: false, type: "date" },
                                            Id: { editable: false, type: "number" }
                                        }
                                    }
                                },
                                requestEnd: function(e) {
                                    if (e.type == "create" || e.type == "update") {
                                        this.read();
                                    }
                                },
                                error: function (e) {
                                    display_kendoui_grid_error(e);
                                    // Cancel the changes
                                    this.cancelChanges();
                                },
                                serverPaging: true,
                                serverFiltering: true,
                                serverSorting: true
                            },
                            pageable: {
                                refresh: true,
                                numeric: false,
                                previousNext: false,
                                info: false
                            },
                            editable: {
                                confirmation: false,
                                mode: "inline"
                            },
                            scrollable: false,
                            columns: [{
                                field: "Name",
                                title: "名称",
                                width: 300
                            }, {
                                field: "Seconds",
                                title: "间隔时间(秒)",
                                width: 50
                            },

            {
                field: "Enabled",
                title: "已启用",
                width: 100,
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: '<img src="@Url.Content("~/Content/images/")active-#=Enabled#.gif" />'
            }, {
                field: "StopOnError",
                title: "发生错误时停止",
                width: 100,
                headerAttributes: { style: "text-align:center" },
                attributes: { style: "text-align:center" },
                template: '<img src="@Url.Content("~/Content/images/")active-#=StopOnError#.gif" />'
            }, {
                field: "LastStartUtc",
                title: "最后开始日期",
                width: 200,
                type: "date",
                format: "{0:G}"
            }, {
                field: "LastEndUtc",
                title: "最后结束日期",
                width: 200,
                type: "date",
                format: "{0:G}"
            }, {
                field: "LastSuccessUtc",
                title: "最后成功日志",
                width: 200,
                type: "date",
                format: "{0:G}"
            }, {
                field: "Id",
                title: "立即运行",
                width: 100,
                template: '<a href="@Url.Content("~/Admin/ScheduleTask/RunNow/")#=Id#" class="k-button run-now">立即运行</a>'
            }, {
                command:[ { name: "edit", text: "编辑" }]}
                            ]
                        });

                    }
                });
            </script>
        </td>
    </tr>
</table>
