@{
    ViewBag.Title = "HK-FayaAdibus获取补货单配置";
}
@using HK_EDI.Web.Models.Setting
@model HK_EDI.Web.Models.Setting.fayaadibusReplenishmentOrderSetSettingModel

@using (Html.BeginForm())
{ 
    <table class="adminContent">
        <tr>
            <td class="adminTitle">
                <label>公司代码</label>
            </td>
            <td class="adminData">
                @Html.EditorFor(model => model.CompanyId)
            </td>
        </tr>
        <tr>
            <td class="adminTitle">
                <label>操作员ID</label>
            </td>
            <td class="adminData">
                @Html.EditorFor(model => model.CheckerID)
            </td>
        </tr>
        <tr>
            <td class="adminTitle">
                <label>发货仓编号(可不填，多个用|分隔)</label>
            </td>
            <td class="adminData">
                @Html.EditorFor(model => model.DeparturePOSCode)
            </td>
        </tr>

        <tr>
            <td class="adminTitle">
                <label>收货店铺编号(可不填，多个用|分隔)</label>
            </td>
            <td class="adminData">
                @Html.EditorFor(model => model.DestinationPOSCode)
            </td>
        </tr>
        <tr>
            <td class="adminTitle">
                <label>补货单获取地址</label>
            </td>
            <td class="adminData">
                @Html.EditorFor(model => model.GetReplenishmentOrderUrl)
            </td>
        </tr>
        <tr>
            <td class="adminTitle">
                <label>获取接口SERVICE_CODE</label>
            </td>
            <td class="adminData">
                @Html.EditorFor(model => model.SERVICECODE)
            </td>
        </tr>
        <tr>
            <td class="adminTitle">
                <label>获取接口最近几天数据</label>
            </td>
            <td class="adminData">
                @Html.EditorFor(model => model.GetDate)
            </td>
        </tr>
        <tr>
            <td class="adminTitle">
                <label>接口获取数据日期(天数为负时有效)</label>
            </td>
            <td class="adminData">
                @Html.EditorFor(model => model.BeginDate)
            </td>
        </tr>

        <tr>
            <td class="adminTitle">
                <label>FRS确认补货单数量地址</label>
            </td>
            <td class="adminData">
                @Html.EditorFor(model => model.PushReplenishmentOrderUrl)
            </td>
        </tr>

        <tr>
            <td class="adminTitle">
                <label>确认接口SERVICE_CODE</label>
            </td>
            <td class="adminData">
                @Html.EditorFor(model => model.PUSSERVICECODE)
            </td>
        </tr>

    </table>


    <div>
        <button type="submit" name="save" value="save" class="k-button">
            保存
        </button>
    </div>
}
